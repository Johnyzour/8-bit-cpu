-- program.mem: test program for the von Neumann CPU
-- One instruction per line: 6 hex digits = opcode, rd/rs, imm.
-- Instruction n is stored at addresses 3n, 3n+1, 3n+2.
-- Lines starting with -- and blank lines are skipped;
-- text after the 6 digits is ignored.

01000F   -- 00: LDI R0, 0F
01103C   -- 03: LDI R1, 3C
022100   -- 06: MOV R2, R1      R2 = 3C
052000   -- 09: ADD R2, R0      R2 = 4B
072100   -- 0C: AND R2, R1      R2 = 08
082000   -- 0F: OR  R2, R0      R2 = 0F
092000   -- 12: XOR R2, R0      R2 = 00, Z = 1
0D001B   -- 15: JZ 1B           taken
0130FF   -- 18: LDI R3, FF      must be skipped
0A2000   -- 1B: NOT R2          R2 = FF
0420F0   -- 1E: ST R2, F0       MEM[F0] = FF
0330F0   -- 21: LD R3, F0       R3 = FF
060100   -- 24: SUB R0, R1      R0 = D3, C = 1
0F002D   -- 27: JC 2D           taken
013000   -- 2A: LDI R3, 00      must be skipped
0B3200   -- 2D: CMP R3, R2      Z = 1, R3 unchanged
0E0099   -- 30: JNZ 99          not taken
000000   -- 33: NOP
122000   -- 36: INC R2          R2 = 00, Z = 1, C = 1
131000   -- 39: DEC R1          R1 = 3B
100000   -- 3C: SHL R0          R0 = A6, C = 1
110000   -- 3F: SHR R0          R0 = 53, C = 0
16005A   -- 42: CALL 5A         SP = EF, MEM[EF] = 45
140000   -- 45: PUSH R0         SP = EF, MEM[EF] = 54
152000   -- 48: POP R2          R2 = 54, SP = F0
013003   -- 4B: LDI R3, 03      loop counter
160069   -- 4E: CALL 69         loop: R0 = R0 + 1
133000   -- 51: DEC R3
0E004E   -- 54: JNZ 4E          3 times, then R0 = 57
0C006F   -- 57: JMP 6F          to the register-indirect section
141000   -- 5A: PUSH R1         SP = EE, MEM[EE] = 3B
011077   -- 5D: LDI R1, 77      R1 = 77
160069   -- 60: CALL 69         nested: SP = ED, MEM[ED] = 63
151000   -- 63: POP R1          R1 = 3B, SP = EF
170000   -- 66: RET             PC = 45, SP = F0
120000   -- 69: INC R0
170000   -- 6C: RET
0130F1   -- 6F: LDI R3, F1      pointer
190300   -- 72: STR R0, [R3]    MEM[F1] = 57
123000   -- 75: INC R3          pointer = F2
191300   -- 78: STR R1, [R3]    MEM[F2] = 3B
123000   -- 7B: INC R3          pointer = F3
192300   -- 7E: STR R2, [R3]    MEM[F3] = 54
010000   -- 81: LDI R0, 00      sum
0130F1   -- 84: LDI R3, F1      pointer back to F1
012003   -- 87: LDI R2, 03      counter
181300   -- 8A: LDR R1, [R3]    loop: R1 = MEM[pointer]
050100   -- 8D: ADD R0, R1      sum
123000   -- 90: INC R3          next byte
132000   -- 93: DEC R2
0E008A   -- 96: JNZ 8A          3 times
0C0099   -- 99: JMP 99 (halt)   R0 = E6